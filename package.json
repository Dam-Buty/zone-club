{
  "name": "zone-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:mobile": "next dev --hostname 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "audit:unused": "node scripts/audit-unused-files.mjs",
    "audit:unused:strict": "node scripts/audit-unused-files.mjs --strict",
    "seed": "npx tsx scripts/seed-films.ts",
    "report": "npx tsx scripts/collection-report.ts",
    "test:player-flow": "node scripts/test-player-flow.mjs",
    "test:phase": "node --test \"tests/**/*.test.mjs\"",
    "test:phase:full": "npm run test:phase && npm run build",
    "docker:build": "docker compose build app",
    "deploy": "docker compose down app && sudo rm -rf .next && npm run build && docker compose up -d app",
    "transcode:progress": "scripts/transcode-progress.sh",
    "movies:clean-originals": "scripts/clean-originals.sh",
    "bot:up": "docker compose up -d zone-discord-bot",
    "bot:down": "docker compose down zone-discord-bot",
    "bot:restart": "docker compose restart zone-discord-bot",
    "bot:rebuild": "docker compose up -d --build zone-discord-bot",
    "bot:logs": "docker compose logs -f zone-discord-bot",
    "cinema:up": "docker compose up -d cinema-stream",
    "cinema:down": "docker compose down cinema-stream",
    "cinema:restart": "docker compose restart cinema-stream",
    "cinema:rebuild": "docker compose up -d --build cinema-stream",
    "cinema:logs": "docker compose logs -f cinema-stream",
    "loopback:start": "pactl load-module module-loopback source=zone-cinema.monitor latency_msec=50 >/dev/null && echo 'Loopback zone-cinema → default sink : ON'",
    "loopback:stop": "pactl list short modules | awk '$2 == \"module-loopback\" && /zone-cinema/ {print $1}' | xargs -rn1 pactl unload-module && echo 'Loopback : OFF'",
    "loopback:status": "pactl list short modules | awk '$2 == \"module-loopback\" && /zone-cinema/' | grep -q . && echo 'Loopback : ON' || echo 'Loopback : OFF'",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.30",
    "@ai-sdk/react": "^3.0.99",
    "@langfuse/otel": "^4.6.1",
    "@langfuse/tracing": "^4.6.1",
    "@opentelemetry/sdk-trace-node": "^2.5.1",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.90.20",
    "@types/three": "^0.182.0",
    "@use-gesture/react": "^10.3.1",
    "ai": "^6.0.97",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.6.2",
    "cookie-signature": "^1.2.2",
    "fluent-ffmpeg": "^2.1.3",
    "next": "^15.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "three": "^0.183.2",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-signature": "^1.1.2",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^4.1.6",
    "@webgpu/types": "^0.1.69",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.6"
  }
}
