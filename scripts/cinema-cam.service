[Unit]
Description=Zone Club Cinéma — bridge HLS vers caméra virtuelle (v4l2loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="VIDEO_NR=10"
Environment="CARD_LABEL=Zone Club Cinéma"
Environment="HLS_URL=https://club-storage.lazone.at/cinema-live/live.m3u8"
Environment="SCALE=1280:720"
ExecStart=/usr/local/bin/cinema-cam.sh
ExecStopPost=-/sbin/modprobe -r v4l2loopback
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
