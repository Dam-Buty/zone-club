# Domain configuration
DOMAIN=
SUBDOMAIN=
STORAGE_SUBDOMAIN=

# Radarr unique
RADARR_API_KEY=
RADARR_QUALITY_PROFILE_ID=
RADARR_QUALITY_PROFILE_ID_FR=

# Encodage GPU distant (pipe SSH vers le Spark)
# Optionnels : l'entrypoint retombe sur 82.65.17.134 / 2222 / damso.
# La cle privee vient du bind /home/damso/.ssh:/ssh-host:ro
SPARK_SSH_HOSTNAME=
SPARK_SSH_PORT=
SPARK_SSH_USER=

# Au-dessus de ce debit video, on reencode meme si la source est deja lisible
# (bande passante de streaming). En dessous: copie directe, pas de GPU. Defaut 6000000.
VIDEO_COPY_MAX_BITRATE=

# Controle qualite des releases (applique apres telechargement : l'API de
# l'indexeur n'expose aucune metadonnee audio). Mettre a 'false' pour desactiver
# une exigence. Apres QC_MAX_ATTEMPTS rejets, le film est flagge 'qc_failed'.
QC_REQUIRE_VF_AUDIO=
QC_REQUIRE_VO_AUDIO=
QC_REQUIRE_FR_SUBS=
QC_MAX_ATTEMPTS=

# TMDB
TMDB_API_KEY=
NEXT_PUBLIC_TMDB_API_KEY=

# Security
HMAC_SECRET=
API_SECRET=                              # API key for automated testing (x-api-key header)

# LLM (Manager IA)
OPENROUTER_API_KEY=

# Langfuse (LLM observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Paths
SABNZBD_DOWNLOADS=/data/phat-two/sabnzbd-downloads
